# ==============================================================================
# Lemon Squeezy Web Checkout (Recommended for Pakistan & Direct UBL Payouts)
# ==============================================================================
# Payout Path: Lemon Squeezy -> Payoneer -> 1-click withdrawal to UBL Bank IBAN (PKR/USD)
# 1. Create your two products on lemonsqueezy.com: Plus ($4.99) & Premium ($9.99).
# 2. Paste the variant checkout share URLs below:
NEXT_PUBLIC_LEMONSQUEEZY_PLUS_URL=https://audioby.lemonsqueezy.com/buy/your-plus-variant-id
NEXT_PUBLIC_LEMONSQUEEZY_PREMIUM_URL=https://audioby.lemonsqueezy.com/buy/your-premium-variant-id

# 3. In Lemon Squeezy Dashboard -> Settings -> Webhooks, add your webhook URL:
#    URL: https://audioby.app/api/webhooks/lemonsqueezy
#    Events: subscription_created, subscription_updated, subscription_cancelled, subscription_resumed, subscription_expired
#    Paste the secret you set in Lemon Squeezy below:
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# ==============================================================================
# RevenueCat Server-Side Secret Key
# ==============================================================================
# Used by /api/webhooks/lemonsqueezy to grant/revoke Plus and Premium entitlements
# for the user's Firebase UID upon payment.
# Found in: RevenueCat Dashboard -> Project Settings -> API Keys -> Secret API Key (starts with sk_)
REVENUECAT_SECRET_KEY=sk_iYSkvwfaoqbPgjhtWgPVFlfIRivsG

# ==============================================================================
# Alternative: Stripe Checkout (Optional fallback)
# ==============================================================================
NEXT_PUBLIC_STRIPE_PLUS_URL=
NEXT_PUBLIC_STRIPE_PREMIUM_URL=

# ==============================================================================
# App Store Listing URL
# ==============================================================================
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/audioby/id6807599877
