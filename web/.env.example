# Firebase Web Client Configuration (Matches AudioBy iOS Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=audioby-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=audioby-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=audioby-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Whop checkout. Create two renewal plans in the Whop dashboard and paste their plan ids.
# API key: Whop Developer -> API keys. Never expose this in the browser.
WHOP_API_KEY=
WHOP_PLUS_PLAN_ID=
WHOP_PREMIUM_PLAN_ID=

# Whop Developer -> Create webhook
# URL: https://audioby.vercel.app/api/webhooks/whop
# Events: membership.activated, membership.updated
# Secret is a ws_ string. Store it exactly as Whop shows it.
WHOP_WEBHOOK_SECRET=

# RevenueCat secret used by the Whop webhook to grant/revoke plus and premium
# for the buyer's Firebase uid. Dashboard -> Project Settings -> API Keys.
REVENUECAT_SECRET_KEY=

# App Store listing URL
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/audioby/id6807599877
